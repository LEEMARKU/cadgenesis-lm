# CADGenesis-LM serving image (Pillar 11: REST + gRPC + SSE + WebSocket)
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml setup.py requirements.txt ./
COPY src ./src
COPY sdk ./sdk

RUN pip install --no-cache-dir -e ".[serve,monitoring]"

ENV PYTHONPATH=/app/src:/app/sdk
ENV CADGENESIS_MODEL=/models/best_checkpoint.pt
ENV CADGENESIS_AUDIT_LOG=/var/log/cadgenesis/audit.jsonl
ENV CADGENESIS_REGISTRY=/models/registry

RUN mkdir -p /models /var/log/cadgenesis && \
    useradd --create-home --uid 1000 cadgenesis && \
    chown -R cadgenesis:cadgenesis /models /var/log/cadgenesis /app

USER cadgenesis

EXPOSE 8000 8001 50051
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4)"

CMD ["python", "-m", "cadgenesis.cli", "serve", "--host", "0.0.0.0", "--port", "8000"]
