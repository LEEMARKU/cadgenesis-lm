# CADGenesis-LM environment variables (copy to `.env` and fill in).
# Never commit real secrets.

# Logging / telemetry
LOG_LEVEL=INFO

# Inference defaults
CADGENESIS_DEVICE=auto
CADGENESIS_MODEL=outputs/cadgenesis_train/best_checkpoint.pt

# External API keys (optional integrations)
OPENAI_API_KEY=
TOON_DEFAULT_MODEL=gpt-4

# Experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=cadgenesis-lm

# External data root (outside the git repo)
CADGENESIS_DATA_ROOT=external/CADGenesis-Data
