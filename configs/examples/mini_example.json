{
  "experiment_name": "cadgenesis_mini_example",
  "seed": 42,
  "output_dir": "outputs/cadgenesis_mini_example",
  "cache_dir": ".cache/cadgenesis",
  "tokenizer_path": null,
  "tokenizer": {
    "lang_vocab_size": 512,
    "lang_max_len": 512,
    "num_bins": 20,
    "param_min": 0.0,
    "param_max": 1000.0,
    "angle_bins": 360,
    "max_feature_tokens": 512,
    "max_cad_seq_len": 1024,
    "geometry_token_slots": 512,
    "feature_token_slots": 512,
    "constraint_token_slots": 256,
    "material_token_slots": 256,
    "assembly_token_slots": 256,
    "manufacturing_token_slots": 256,
    "simulation_token_slots": 256,
    "numeric_token_slots": 1024,
    "special_token_slots": 64
  },
  "model": {
    "d_model": 128,
    "nhead": 4,
    "num_encoder_layers": 3,
    "num_decoder_layers": 3,
    "dim_feedforward": 256,
    "dropout": 0.1,
    "max_seq_len": 2048,
    "rope_theta": 10000.0,
    "self_attn_heads": 2,
    "geometry_attn_heads": 1,
    "constraint_attn_heads": 0,
    "memory_attn_heads": 0,
    "agent_attn_heads": 1,
    "uncertainty_attn_heads": 0,
    "use_moe": false,
    "num_experts": 4,
    "top_k_experts": 2,
    "expert_dim": null,
    "expert_router_jitter": 0.02,
    "attention_backend": "math",
    "geometry_pos_encoding": false,
    "feature_interaction": false,
    "interaction_heads": 2
  },
  "training": {
    "batch_size": 64,
    "grad_accum_steps": 4,
    "max_epochs": 8,
    "warmup_steps": 2000,
    "lr": 0.0003,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "gradient_checkpointing": false,
    "mixed_precision": "no",
    "save_every_n_steps": 500,
    "eval_every_n_steps": 200
  },
  "lora": {
    "rank": 16,
    "alpha": 32.0,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
    "use_qlora": false,
    "qlora_bits": 4
  },
  "memory": {
    "embedding_dim": 1024,
    "working_memory_slots": 64,
    "session_memory_slots": 512,
    "user_memory_slots": 2048,
    "project_memory_slots": 4096,
    "cad_memory_slots": 8192,
    "engineering_memory_slots": 4096,
    "manufacturing_memory_slots": 2048,
    "simulation_memory_slots": 2048,
    "retrieval_top_k": 16
  }
}
